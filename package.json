{
	"name": "devhub-crm",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": ">=24.10.0",
		"pnpm": ">=12.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node ./build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && vp lint && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"format": "vp fmt",
		"lint": "vp lint",
		"test:unit": "vitest",
		"test:client": "vitest --project client",
		"test:server": "vitest --project server",
		"test:ci": "vitest --run",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"better-auth": "^1.7.3",
		"qr-code-styling": "^1.9.2",
		"sqlite-vec": "0.1.9"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "5.0.0",
		"daisyui": "^5.7.28",
		"date-fns": "^4.4.0",
		"fathom-client": "^3.7.2",
		"playwright": "^1.63.0",
		"resend": "^6.26.0",
		"svead": "^0.0.16",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-turnstile": "^0.11.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"valibot": "^1.4.2",
		"vite": "^8.2.2",
		"vite-plus": "0.3.0",
		"vitest": "5.0.0",
		"vitest-browser-svelte": "2.2.1"
	}
}
